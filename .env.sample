# Generate once with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-your-base64-encoded-32-byte-key
# Same value in this file and in the Hatchbox app environment. Empty disables /admin.
ADMIN_TOKEN=replace-with-a-shared-admin-token
# Used by bin/admin_api. The server does not read this.
ADMIN_API_HOST=https://your-app.example
ADDR=:8080
DATA_DIR=./data
# Empty permits any public HTTPS webhook host. Set a list to restrict it.
WEBHOOK_HOSTS=
MODEL_CONCURRENCY=300
WEBHOOK_CONCURRENCY=50
MODEL_TIMEOUT=10m
WEBHOOK_TIMEOUT=15s
WEBHOOK_ATTEMPTS=12
MAX_JOBS=10000
RETENTION=24h
